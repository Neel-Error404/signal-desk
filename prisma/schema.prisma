generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SignalState {
  NEW       @map("new")
  REVIEWING @map("reviewing")
  ACCEPTED  @map("accepted")
  REJECTED  @map("rejected")
}

enum ProductIssuePriority {
  LOW      @map("low")
  MEDIUM   @map("medium")
  HIGH     @map("high")
  CRITICAL @map("critical")
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  signal    Signal?
}

model Signal {
  id           String        @id @default(uuid()) @db.Uuid
  feedbackId   String        @unique @db.Uuid
  statement    String        @db.Text
  state        SignalState   @default(NEW)
  revision     Int           @default(0)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  feedback     Feedback      @relation(fields: [feedbackId], references: [id], onDelete: Restrict)
  triageEvents TriageEvent[]
  productIssue ProductIssue?

  @@index([createdAt, id])
}

model ProductIssue {
  id                   String               @id @default(uuid()) @db.Uuid
  signalId             String               @unique @db.Uuid
  sourceSignalRevision Int
  title                String               @db.VarChar(200)
  priority             ProductIssuePriority
  rationale            String               @db.Text
  operatorLabel        String               @db.VarChar(120)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  signal               Signal               @relation(fields: [signalId], references: [id], onDelete: Restrict)

  @@index([priority, createdAt, id])
}

model TriageEvent {
  id            String      @id @default(uuid()) @db.Uuid
  signalId      String      @db.Uuid
  sequence      Int
  fromState     SignalState
  toState       SignalState
  rationale     String      @db.Text
  operatorLabel String      @db.VarChar(120)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  signal        Signal      @relation(fields: [signalId], references: [id], onDelete: Restrict)

  @@unique([signalId, sequence])
  @@index([signalId, createdAt])
}
