{
  "schemaVersion": 2,
  "id": "signaldesk-sd008-azure-authority-v2",
  "status": "ratified-local-implementation",
  "projectId": "signaldesk",
  "workItem": "SD-008",
  "provider": "Microsoft Azure",
  "assignmentBoundary": {
    "production": "forbidden",
    "tenantWide": "forbidden",
    "persistentAssignmentWithoutSession": "forbidden",
    "roleDefinitionScope": "subscription-definition-only",
    "runtimeMutationScopes": [
      "exact-resource-group",
      "exact-container-app",
      "minimal-subscription-read-only"
    ]
  },
  "justInTimeAuthority": {
    "packetMode": "exactly-one-requested-phase",
    "maximumLeaseMinutes": 480,
    "providerEnforcedAssignmentExpiry": false,
    "assignmentExpiryEvidence": "procedural",
    "assignmentExpiryEvidenceDetail": "owner-record-and-workflow-reread",
    "automaticRenewal": "forbidden",
    "approvalBinding": {
      "source": "owner-controlled-github-environment-variables",
      "requiredVariables": [
        "SD008_AUTHORITY_APPROVAL_REFERENCE",
        "SD008_AUTHORITY_APPROVAL_DIGEST",
        "SD008_AUTHORITY_APPROVED_AT"
      ],
      "validatorComparison": "exact-reference-digest-and-time",
      "liveGitHubReviewEventVerification": false,
      "limitation": "The local workflow validates owner-controlled protected-environment values; it does not query or cryptographically verify the GitHub approval event."
    },
    "authenticatedIdentityBinding": {
      "packetFields": [
        "azure-client-id",
        "service-principal-object-id",
        "azure-tenant-id",
        "principal-type"
      ],
      "protectedEnvironmentSources": [
        "AZURE_CLIENT_ID",
        "AZURE_TENANT_ID"
      ],
      "liveContextReads": [
        "az account show user.type",
        "az account get-access-token ARM token decoded locally for appid oid tid"
      ],
      "requiredPrincipalType": "ServicePrincipal",
      "secretMaterial": "forbidden"
    },
    "continuousAuthorityVerification": {
      "timing": "immediately-before-every-declared-mutation",
      "directAndInheritedAssignments": "exact-phase-packet-only",
      "assignmentFields": [
        "id",
        "roleDefinitionId",
        "scope",
        "principalId",
        "principalType",
        "condition",
        "conditionVersion"
      ],
      "customRoleFields": [
        "Actions",
        "NotActions",
        "DataActions",
        "NotDataActions",
        "AssignableScopes"
      ],
      "tokenGroupSignalPrecondition": "The current ARM access token must decode locally with exact appid, oid, and tid claims and expose neither a non-empty groups claim nor a group-overage signal",
      "tokenGroupSignalLimitation": "Absence of group and overage signals in the current ARM token does not prove that the service principal has no Microsoft Entra group memberships",
      "postDeleteTeardownClosure": "verifier-only live assignment set plus exact packet-bound teardown assignment ARM GET returning 404",
      "enumerationFailure": "fail-closed"
    },
    "identifierRules": {
      "uuidCanonicalization": "lowercase-before-deterministic-derivation",
      "resourceGroup": "azure-resource-group-name",
      "containerApp": "lowercase-2-to-32-start-letter-end-alphanumeric-no-consecutive-hyphens"
    },
    "minimumRemainingMinutesByMutation": {
