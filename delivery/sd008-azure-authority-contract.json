      "provision-bootstrap-job-start": 90,
      "provision-migration-job-start": 90,
      "provision-app-update": 90,
      "traffic-promotion": 45,
      "traffic-rollback": 15,
      "traffic-restore": 15,
      "teardown-delete": 60,
      "teardown-closure": 60
    },
    "phases": {
      "provision": {
        "approvalEnvironment": "staging-provision",
        "roleIds": [
          "sd008-provision-v1"
        ],
        "preconditions": [
          "exact-protected-source",
          "exact-private-publication-evidence",
          "separately-approved-publication-verification",
          "owner-approved-provision-packet"
        ],
        "forbiddenConcurrentRoleIds": [
          "sd008-traffic-v1",
          "sd008-evidence-reader-v1",
          "sd008-teardown-v1",
          "sd008-post-delete-verifier-v1"
        ]
      },
      "traffic": {
        "approvalEnvironment": "staging-traffic",
        "roleIds": [
          "sd008-traffic-v1",
          "sd008-evidence-reader-v1"
        ],
        "preconditions": [
          "exact-container-app-exists",
          "provision-assignment-absent",
          "owner-approved-traffic-packet"
        ],
        "forbiddenConcurrentRoleIds": [
          "sd008-provision-v1",
          "sd008-teardown-v1",
          "sd008-post-delete-verifier-v1"
        ]
      },
      "teardown": {
        "approvalEnvironment": "staging-teardown",
        "roleIds": [
          "sd008-teardown-v1",
          "sd008-post-delete-verifier-v1"
        ],
        "preconditions": [
          "provision-assignment-absent",
          "traffic-and-evidence-reader-assignments-absent",
          "fresh-owner-approved-teardown-packet"
        ],
        "forbiddenConcurrentRoleIds": [
          "sd008-provision-v1",
          "sd008-traffic-v1",
          "sd008-evidence-reader-v1"
        ],
        "priorTrafficAuthorityClosureBinding": {
          "required": true,
          "requiredVariables": [
            "SD008_TRAFFIC_AUTHORITY_CLOSURE_SHA256",
            "SD008_TRAFFIC_AUTHORITY_REMOVED_AT"
          ],
          "freshnessRule": "teardown-issued-at-strictly-after-traffic-authority-removed-at"
        },
        "removalOrder": [
          "sd008-teardown-v1",
          "sd008-post-delete-verifier-v1"
        ]
      }
    },
    "ingressCredential": {
      "kind": "per-session-entra-client-secret",
      "githubEnvironment": "staging-provision",
      "secretName": "ENTRA_CLIENT_SECRET",
      "justInTime": true,
      "longLived": false,
      "maximumLifetimeMinutes": 480,
      "repositoryStorage": "forbidden",
      "workflowArtifactStorage": "forbidden",
      "ownerCleanupRequired": [
