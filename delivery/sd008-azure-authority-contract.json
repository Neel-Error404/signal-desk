    "partialBootstrapCompensation": {
      "bounded": true,
      "automaticAuthorityRenewal": false,
      "maximumCleanupMinutes": 15,
      "requiredOrder": [
        "stop-new-mutations",
        "remove-any-created-phase-role-assignments",
        "remove-staging-provision-environment-secret-if-created",
        "revoke-jit-ingress-credential-if-created",
        "delete-owner-created-empty-resource-group-if-safe",
        "verify-assignment-credential-and-resource-absence",
        "record-blocking-incident"
      ],
      "insufficientCurrentAuthority": "obtain-separately-approved-fresh-teardown-authority-before-cleanup",
      "silentOrUnboundedCleanup": "forbidden"
    }
